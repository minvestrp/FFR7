# Multi-stage production Dockerfile (multi-stage, non-root, minimal runtime)

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Build dependencies for wheels (only in builder stage)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       gcc \
       libcairo2-dev \
       libpango1.0-dev \
       libgdk-pixbuf2.0-dev \
       libffi-dev \
       libxml2-dev \
       libxslt1-dev \
       libjpeg62-turbo-dev \
       zlib1g-dev \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /wheels
COPY requirements.txt /wheels/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip wheel --no-cache-dir --wheel-dir=/wheels -r /wheels/requirements.txt


FROM python:3.11-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Minimal runtime system libs required by WeasyPrint and image libs
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libcairo2 \
       libpango-1.0-0 \
       libgdk-pixbuf2.0-0 \
       libjpeg62-turbo \
       zlib1g \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user and workdir
RUN useradd --create-home --shell /bin/bash --uid 1000 appuser
WORKDIR /app

# Copy wheels from builder and install from wheels (no build tools in runtime)
COPY --from=builder /wheels /wheels
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels -r /app/requirements.txt

# Copy application code
COPY . /app
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

EXPOSE 8000

# Production server: uvicorn with multiple workers
CMD ["uvicorn", "interface.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
